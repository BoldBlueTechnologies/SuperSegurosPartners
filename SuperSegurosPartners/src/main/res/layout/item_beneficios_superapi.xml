<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@+id/btnCardOpen_superapi"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    android:backgroundTint="@color/white1_superapi"
    app:cardElevation="4dp">
    <LinearLayout
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtTitulo_superapi"
                android:layout_weight="0.4"
                android:gravity="start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vacio_superapi"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="13sp"
                android:textColor="@color/black1_superapi"/>
            <TextView
                android:id="@+id/txtsubTitulo_superapi"
                android:gravity="end"
                android:layout_weight="0.6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vacio_superapi"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="13sp"
                android:textColor="@color/purple1_superapi"/>
            <ImageView
                android:id="@+id/imgOpen_superapi"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/dropdown_superapi"/>
        </LinearLayout>
        <TextView
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:id="@+id/txtTexto_superapi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vacio_superapi"
            android:fontFamily="@font/poppins_regular"
            android:textSize="13sp"
            android:textColor="@color/black1_superapi"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>